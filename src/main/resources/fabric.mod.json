	"description": "Mod to create custom gym badges for cobblemon",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/badgemod/icon.png",
	"environment": "*",
	"entrypoints": {
