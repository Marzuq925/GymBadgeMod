			"net.marz.badgemod.MarzsGymBadgeModDataGenerator"
		],
		"client": [
			"net.marz.badgemod.MarzsGymBadgeModClient"
		]
	},
	"mixins": [
		"badgemod.mixins.json"
	],
	"depends": {
